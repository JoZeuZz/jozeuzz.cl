{
  "schema": "jz-autonomy-objective-v1",
  "unit": "JZ-AUTONOMY-V2-I2-DEMO",
  "objective": "Añadir summarizeRun(result) en tools/jz-autonomy/src/summary.js y tests en tools/jz-autonomy/test/summary.test.js",
  "criteria": [
    "salida estable result=<status> corrections=<n> checks=<passed>/<total>",
    "TypeError para input inválido",
    "sin dependencias"
  ],
  "workspace": ".",
  "branch": "chore/jz-agents",
  "agent": "jz-implementer",
  "workflow": "split-tdd",
  "testPaths": [
    "tools/jz-autonomy/test/summary.test.js"
  ],
  "allowedPaths": [
    "tools/jz-autonomy/src/summary.js",
    "tools/jz-autonomy/test/summary.test.js"
  ],
  "checks": [
    {
      "id": "summary-focal",
      "argv": ["node", "--test", "tools/jz-autonomy/test/summary.test.js"]
    },
    {
      "id": "summary-suite",
      "argv": ["node", "--test", "tools/jz-autonomy/test/"]
    }
  ],
  "maxCorrections": 1,
  "commit": {
    "message": "feat(autonomy): add run summary"
  }
}
