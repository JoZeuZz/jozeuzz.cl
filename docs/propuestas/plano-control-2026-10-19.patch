+  const viewer = spawn('tail', ['-f', bin]);
+  const run = spawn('bash', ['-c', 'exec -a unshare tail -f "$0"', bin]); // como el proceso unshare de jz-run
+  try {
+    await waitFor(() => fs.readFileSync(`/proc/${run.pid}/cmdline`, 'utf8').startsWith('unshare\0'));
