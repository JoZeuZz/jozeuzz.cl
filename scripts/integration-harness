#!/usr/bin/env bash
# scripts/integration-harness
#
# Inicia PostgreSQL 18.6 en puerto efímero localhost, aplica migración,
# ejecuta test:integration, opcionalmente build+probes REST/GraphQL, y limpia.
#
# Uso:
#   ./scripts/integration-harness            # migración + integración
#   ./scripts/integration-harness --smoke    # + build Next + probes HTTP
#
# Variables de entorno respetadas:
#   JZ_PG_PORT   fuerza un puerto concreto (por defecto efímero desde PID)
#   PAYLOAD_SECRET  (por defecto: harness-secret)

set -euo pipefail

SMOKE=0
for arg in "$@"; do
  [[ "$arg" == "--smoke" ]] && SMOKE=1
done

# ── Puerto efímero ──────────────────────────────────────────────────────────
PG_PORT="${JZ_PG_PORT:-$(( 20000 + (BASHPID % 10000) ))}"
CONTAINER="jz-harness-$$"
DB_URL="postgres://jozeuzz:jozeuzz@127.0.0.1:${PG_PORT}/jozeuzz"
PAYLOAD_SECRET="${PAYLOAD_SECRET:-harness-secret}"
SERVER_URL="http://127.0.0.1:3000"
NODE_IMAGE="$(tr -d '\r\n' < tooling/node-image.txt)"
PG_IMAGE="postgres@sha256:edb0c08dc33befd0262ab3b5cf1c4f3f8cfd8b09e88c05b45adee29d6761ddb6"
NEXT_PID=""

cleanup() {
  echo "── cleanup ──"
  [[ -n "$NEXT_PID" ]] && kill "$NEXT_PID" 2>/dev/null || true
  docker rm -f "$CONTAINER" 2>/dev/null || true
}
trap cleanup EXIT INT TERM

# ── Arrancar PostgreSQL 18.6 ────────────────────────────────────────────────
echo "── PostgreSQL 18.6 en puerto ${PG_PORT} ──"
docker run -d --name "$CONTAINER" \
  -e POSTGRES_USER=jozeuzz \
  -e POSTGRES_PASSWORD=jozeuzz \
  -e POSTGRES_DB=jozeuzz \
  -p "127.0.0.1:${PG_PORT}:5432" \
  "$PG_IMAGE"

# Esperar readiness (hasta 45s)
for i in $(seq 1 45); do
  docker exec "$CONTAINER" pg_isready -q 2>/dev/null && break
  sleep 1
done
docker exec "$CONTAINER" pg_isready  # falla si no está listo

# ── Función auxiliar run-node con red host ──────────────────────────────────
run_node() {
  docker run --rm \
    --user "$(id -u):$(id -g)" \
    --volume "$PWD:/app" \
    --workdir /app \
    --network host \
    --env DATABASE_URL="$DB_URL" \
    --env PAYLOAD_SECRET="$PAYLOAD_SECRET" \
    --env NEXT_PUBLIC_SERVER_URL="$SERVER_URL" \
    "$NODE_IMAGE" "$@"
}

# ── Migración x1 (debe aplicar exactamente 1) ──────────────────────────────
echo "── migrate run 1 ──"
run_node npx payload migrate 2>&1 | tee /tmp/migrate1.log
grep -q "Migrating:.*20261027_112804\|Migrated:.*20261027" /tmp/migrate1.log || \
  grep -q "20261027_112804" /tmp/migrate1.log || \
  { echo "ERROR: migración no aplicada"; cat /tmp/migrate1.log; exit 1; }

# ── Migración x2 (debe reportar sin pendientes) ────────────────────────────
echo "── migrate run 2 ──"
run_node npx payload migrate 2>&1 | tee /tmp/migrate2.log
grep -qE "Done\." /tmp/migrate2.log || { echo "ERROR: segunda migración falló"; exit 1; }
# Verificar que NO aplicó ninguna migración nueva (solo líneas de log Payload, no bash trace)
if grep -qE "^\[.*\] .*(INFO|WARN).*: .*Migrated:" /tmp/migrate2.log; then
  echo "ERROR: segunda migración aplicó algo inesperado"
  exit 1
fi

# ── Verificar schema: tablas, índices, FKs ──────────────────────────────────
echo "── schema check ──"
docker exec "$CONTAINER" psql -U jozeuzz -d jozeuzz -c "
SELECT table_name FROM information_schema.tables
WHERE table_schema='public' ORDER BY table_name;" | grep -E "solicitudes|servicios|usuarios|payload_migrations"

docker exec "$CONTAINER" psql -U jozeuzz -d jozeuzz -c "
SELECT indexname FROM pg_indexes WHERE schemaname='public'
ORDER BY indexname;" | grep -E "usuarios_email_idx|servicios_slug_idx|solicitudes_servicio_idx"

# ── Test:integration ────────────────────────────────────────────────────────
echo "── test:integration ──"
set +e
run_node npx vitest run test/integration
INTEGRATION_EXIT=$?
set -e
echo "── integration exit=${INTEGRATION_EXIT} ──"

if [[ $SMOKE -eq 0 ]]; then
  echo "── harness complete exit=${INTEGRATION_EXIT} ──"
  exit $INTEGRATION_EXIT
fi

# ── Build Next.js sintético ──────────────────────────────────────────────────
echo "── next build ──"
run_node npx next build

# ── Arrancar servidor Next en background para probes ────────────────────────
echo "── next start (smoke) ──"
docker run -d --name "${CONTAINER}-next" \
  --user "$(id -u):$(id -g)" \
  --volume "$PWD:/app" \
  --workdir /app \
  --network host \
  --env DATABASE_URL="$DB_URL" \
  --env PAYLOAD_SECRET="$PAYLOAD_SECRET" \
  --env NEXT_PUBLIC_SERVER_URL="$SERVER_URL" \
  "$NODE_IMAGE" npx next start -p 3000

# Esperar servidor
for i in $(seq 1 20); do
  curl -sf http://127.0.0.1:3000/api/health 2>/dev/null && break || true
  sleep 2
done

# ── Probes REST genérico anónimo ─────────────────────────────────────────────
echo "── REST probe: anonymous /api/solicitudes ──"
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:3000/api/solicitudes)
[[ "$HTTP_STATUS" == "401" || "$HTTP_STATUS" == "403" ]] || \
  { echo "ERROR: /api/solicitudes anónimo devolvió ${HTTP_STATUS}, esperado 401/403"; exit 1; }

echo "── REST probe: anonymous /api/servicios (generic, not gateway) ──"
HTTP_STATUS=$(curl -s -o /dev/null -w "%{http_code}" http://127.0.0.1:3000/api/servicios)
[[ "$HTTP_STATUS" == "401" || "$HTTP_STATUS" == "403" ]] || \
  { echo "ERROR: /api/servicios anónimo devolvió ${HTTP_STATUS}, esperado 401/403"; exit 1; }

echo "── GraphQL probe: HTTP closed ──"
GQL_STATUS=$(curl -s -o /dev/null -w "%{http_code}" \
  -X POST http://127.0.0.1:3000/api/graphql \
  -H "Content-Type: application/json" \
  -d '{"query":"{ __typename }"}')
[[ "$GQL_STATUS" == "404" || "$GQL_STATUS" == "400" || "$GQL_STATUS" == "403" ]] || \
  { echo "ERROR: /api/graphql devolvió ${HTTP_STATUS}, esperado 404/400/403"; exit 1; }

docker rm -f "${CONTAINER}-next" 2>/dev/null || true

echo "── harness complete (smoke) exit=${INTEGRATION_EXIT} ──"
exit $INTEGRATION_EXIT
