      "*`*": "deny",
      "*$*": "deny",
      "*&*": "deny",
      "*\\*": "deny",
      "git * /*": "deny",
      "git * ../*": "deny",
      "git * ..": "deny",
      "git * ~*": "deny",
      "git * .env*": "deny",
      "git * */.env*": "deny",
      "git * --con*": "deny",
      "git * --ignore-revs*": "deny",
      "git * --exclude-f*": "deny",
      "git blame *-S*": "deny",
      "git ls-files *-X*": "deny",
      "git * -O*": "deny",
      "*[*": "deny",
      "echo /*": "deny",
