      "git branch --show-current": "allow",
      "git worktree list *": "allow",
      "git remote": "allow",
      "git remote -v": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git rm*": "deny",
      "git mv*": "deny",
      "git restore*": "deny",
      "git * --output*": "deny",
      "git * --no-index*": "deny",
      "git * --ext-diff*": "deny",
      "git * --contents*": "deny",
      "git * --exclude-from*": "deny",
      "git * --pathspec-from-file*": "deny",
      "git * --ignore-revs-file*": "deny",
      "git * --exec*": "deny",
      "git * --upload-pack*": "deny",
      "git * --receive-pack*": "deny",
      "ls *..*": "deny",
      "ls /*": "deny",
      "ls * /*": "deny",
      "ls ~*": "deny",
