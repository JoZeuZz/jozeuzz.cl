      "git * --ext*": "deny",
      "git * --exe*": "deny",
      "git * --up*": "deny",
      "git * --rec*": "deny",
      "git * --pathspec-f*": "deny"
    },
    "task": {
      "*": "deny",
      "jz-architect": "allow",
      "jz-explorer": "allow",
      "jz-implementer": "allow",
      "jz-implementer-copilot": "allow",
      "jz-security": "allow",
      "jz-qa": "allow"
    }
  },
