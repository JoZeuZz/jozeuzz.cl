#!/usr/bin/env bash
# jz-state — estado verificable del worktree para reanudar trabajo entre motores.
# Sólo lee: rama, HEAD, cambios, escritor activo, procesos de motores, últimas ejecuciones de
# jz-run (indicando si terminaron en verde sobre el árbol actual), estado de la verificación reconocida
# (jz-verify status), último checkpoint y cuarentena.
# Termina con un veredicto: REANUDABLE o BLOQUEADO (código de salida 0 o 3).
set -euo pipefail

SELF=$(readlink -f "${BASH_SOURCE[0]}")
WT=$(cd "$(dirname "$SELF")/../.." && pwd -P)
STATE=$WT/.jz-state
N=${1:-5}
blockers=()

# Git de consulta con entorno limpio: no hereda GIT_DIR ni GIT_WORK_TREE del motor, no lee la configuración
# global ni de sistema, no ejecuta fsmonitor ni hooks y no toma locks opcionales.
hgit() {
  env -i PATH=/usr/bin:/bin LC_ALL=C GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_OPTIONAL_LOCKS=0 \
    GIT_TERMINAL_PROMPT=0 git --no-pager -c core.fsmonitor=false -c core.hooksPath=/dev/null -C "$WT" "$@"
}

ancestors=" $$ "
pid=$$
while [[ $pid -gt 1 ]]; do
  pid=$(awk '{print $4}' "/proc/$pid/stat" 2>/dev/null || echo 1)
  ancestors+="$pid "
done

echo "# Estado jz — $WT"
echo
echo "- Fecha: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
echo "- Rama: $(hgit branch --show-current)"
echo "- HEAD: $(hgit log -1 --format='%h %s' 2>/dev/null || echo '(sin commits)')"
# Una huella que no se puede calcular (JZ_TREE_*: nombres no UTF-8, repositorios anidados, gitlinks, errores
# de lectura) bloquea: no hay forma de saber qué validan las ejecuciones registradas.
untrusted_tree() {
  echo
  echo "## Veredicto: BLOQUEADO"
  echo "- el árbol no es verificable ($1; ver el error JZ_TREE_* anterior): revisión humana"
  exit 3
}
fp=$("$WT/.jz/bin/jz-run" --fingerprint) || untrusted_tree "huella"
echo "- Huella del árbol actual: $fp"

echo
echo "## Cambios sin confirmar"
# Sin git status: puede ejecutar filtros clean y fsmonitor del repositorio (ver .jz/lib/tree.mjs).
changes=$(node "$WT/.jz/lib/tree.mjs" status "$WT") || untrusted_tree "lista de cambios"
if [[ -z $changes ]]; then echo "Ninguno (árbol limpio)."; else echo '```'; echo "$changes"; echo '```'; fi

# Identidad de quien consulta: compartir proceso no basta para ser la misma sesión.
caller_engine=${JZ_ENGINE:-}
case $caller_engine in
  claude-code) caller_session=${CLAUDE_CODE_SESSION_ID:-} ;;
  opencode) caller_session=${JZ_SESSION:-} ;;
  *) caller_session='' ;;
esac

echo
echo "## Escritor"
if [[ -f $STATE/writer.lock ]]; then
  lpid=$(jq -r '.pid' "$STATE/writer.lock")
  lengine=$(jq -r '.engine // empty' "$STATE/writer.lock")
  lsession=$(jq -r '.session // empty' "$STATE/writer.lock")
  lwriter=$(jq -r '.writer_session // empty' "$STATE/writer.lock")
  lagent=$(jq -r '.agent // empty' "$STATE/writer.lock")
  desc=$(jq -r '"\(.agent) (\(.engine), pid \(.pid), sesión \(.session)\(if .writer_session then ", sesión escritora \(.writer_session)" else "" end), llamada \(.call), desde \(.since))"' "$STATE/writer.lock")
  if kill -0 "$lpid" 2>/dev/null; then
    if [[ $ancestors != *" $lpid "* ]]; then
      echo "ACTIVO (otro proceso): $desc"
      blockers+=("bloqueo de escritor vivo de otro proceso: $desc")
    elif [[ -z $caller_session || $caller_engine != "$lengine" ]]; then
      echo "ACTIVO (mismo proceso, sesión no verificable): $desc"
      blockers+=("bloqueo de escritor vivo sin sesión verificable: $desc")
    elif [[ $lengine == opencode && $caller_session == "$lwriter" ]]; then
      echo "ACTIVO (esta sesión es la escritora titular): $desc"
    elif [[ $caller_session == "$lsession" && $lengine == opencode ]]; then
      echo "ACTIVO (delegación en curso desde esta sesión): $desc. Sólo escribe $lagent."
    elif [[ $caller_session == "$lsession" ]]; then
      echo "ACTIVO (misma sesión de Claude Code): $desc. Sólo escribe el titular ($lagent); por sesión no se distingue al orquestador de su subagente."
    else
      echo "ACTIVO (mismo proceso, otra sesión): $desc"
      blockers+=("bloqueo de escritor vivo de otra sesión: $desc")
    fi
  else
    echo "Huérfano (el proceso ya no existe): $desc. Se recupera solo en la siguiente delegación."
  fi
else
  echo "Ninguno."
fi

echo
echo "## Procesos de motores con directorio en este worktree"
found=0
for d in /proc/[0-9]*; do
  p=${d#/proc/}
  [[ $ancestors == *" $p "* ]] && continue
  comm=$(cat "$d/comm" 2>/dev/null) || continue
  [[ $comm == claude || $comm == opencode ]] || continue
  cwd=$(readlink "$d/cwd" 2>/dev/null) || continue
  case "$cwd/" in "$WT"/*)
    echo "- pid $p $comm (cwd $cwd)"
    found=1
    blockers+=("proceso $comm $p activo en el worktree")
  ;; esac
done
[[ $found -eq 1 ]] || echo "Ninguno (aparte de la sesión que consulta)."

echo
echo "## Últimas ejecuciones de jz-run"
if [[ -s $STATE/runs.jsonl ]]; then
  tail -n "$N" "$STATE/runs.jsonl" | jq -r --arg fp "$fp" \
    '"- \(.ts) rc=\(.rc) [\(.engine)] \(.cmd | tojson) head=\(.head) \(if .tree != $fp then "(otro árbol)" elif .rc == 0 then "(árbol actual, en verde)" else "(árbol actual, falló)" end) — \(.log)"'
  last_ok=$(jq -r --arg fp "$fp" 'select(.tree == $fp and .rc == 0) | .ts' "$STATE/runs.jsonl" | tail -n 1)
  echo
  if [[ -n $last_ok ]]; then
    echo "Árbol actual con ejecución en verde: sí ($last_ok)."
    echo "Sólo indica que alguna ejecución de jz-run terminó con rc=0, sea cual sea el comando: no es una verificación reconocida."
  else echo "Árbol actual con ejecución en verde: NO. Los cambios actuales no están validados."; fi
else
  echo "Sin ejecuciones registradas."
fi

# I2: sólo un perfil de .jz/profiles ejecutado con jz-verify produce evidencia reconocida (.jz-state/verify/).
echo
echo "## Verificación reconocida"
vrc=0
"$WT/.jz/bin/jz-verify" status || vrc=$?
if [[ $vrc -ne 0 ]]; then
  blockers+=("verificación reconocida no comprobable (jz-verify status rc=$vrc): revisión humana")
fi

echo
echo "## Último checkpoint"
if [[ -f $STATE/LATEST.md ]]; then
  grep -E '^- (Unidad|Estado declarado|Siguiente paso|Motor|Fecha):' "$STATE/LATEST.md" || true
  echo "- Archivo: .jz-state/LATEST.md"
else
  echo "Ninguno."
fi

if [[ -d $STATE/quarantine ]] && [[ -n $(ls -A "$STATE/quarantine") ]]; then
  echo
  echo "## Cuarentena"
  find "$STATE/quarantine" -mindepth 2 -maxdepth 4 | sed "s#^$WT/#- #"
  blockers+=("hay rutas en cuarentena: revisión humana")
fi

echo
if [[ ${#blockers[@]} -eq 0 ]]; then
  echo "## Veredicto: REANUDABLE"
  echo "Antes de continuar: leer .jz-state/LATEST.md y las notas, revisar el diff y no repetir a ciegas la última tarea."
  exit 0
fi
echo "## Veredicto: BLOQUEADO"
printf -- '- %s\n' "${blockers[@]}"
exit 3
